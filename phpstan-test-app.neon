includes:
    - extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
parameters:
    level: max
    paths:
        - tests/test_app
    treatPhpDocTypesAsCertain: false
    cakeDC:
        disallowEntityArrayAccessRule: true
    ignoreErrors:
        -
            identifier: missingType.generics
